AUTHFORGE_DATABASE_NAME=auth_db
AUTHFORGE_DATABASE_USERNAME=authuser
AUTHFORGE_DATABASE_PASSWORD=replace-with-a-strong-database-password
AUTHFORGE_JWT_SECRET=replace-with-at-least-32-random-bytes-before-running
